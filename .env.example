# ─── MongoDB ───────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farsamo?retryWrites=true&w=majority

# ─── Server ────────────────────────────────────────────────
PORT=8000
